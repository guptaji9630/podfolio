# Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3000
NODE_ENV=development

# Email Service (Resend)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Your email address where contact form submissions will be sent
RECIPIENT_EMAIL=abhishekg9630@gmail.com

# CORS - Allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# NVIDIA NIM API
# Get your API key from: https://build.nvidia.com/explore/discover
NVIDIA_NIM_API_KEY=your_nim_api_key
NVIDIA_NIM_API_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct

# MCP Configuration
# JSON array of MCP connection configs
# Example for Jira MCP server:
# MCP_CONNECTIONS='[{"id":"jira","name":"Jira","transport":"http","url":"https://your-jira-instance.atlassian.net/mcp","headers":{"Authorization":"Bearer YOUR_TOKEN"},"enabled":true}]'
MCP_CONNECTIONS='[]'
