# Frontend Environment Variables
# Copy this file to .env and fill in your values

# API Configuration
VITE_API_BASE_URL=http://localhost:3000/api

# NVIDIA NIM API (for AI chat)
VITE_NVIDIA_NIM_API_URL=/api/nim/chat/completions
VITE_NVIDIA_NIM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_AI_TOOLS=true

# MCP admin credentials are entered at runtime in Settings > MCP Tools.
# Do not put admin credentials in frontend environment variables.

# Optional: Override default app config
# VITE_APP_NAME=Abhishek Portfolio
# VITE_APP_VERSION=1.0.0